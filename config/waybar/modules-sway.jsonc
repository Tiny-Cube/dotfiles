{
  "sway/workspaces": {
    "disable-scroll": false,
    "disable-scroll-wraparound": true,
    "format": "{index}{icon}",
    "format-icons": {
      "focused": "|",
      "default": ""
    }
  },
  "sway/window": {
    "format": "{}",
    "max-length": 40,
    "icon": false,
  },
  "sway/mode": {
    "format": "   {}",
    "max-length": 50
  }
}
