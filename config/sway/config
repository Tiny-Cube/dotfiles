# Read `man 5 sway` for a complete reference.

# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down j
set $up k
set $right l
# Your preferred terminal emulator
#set $term foot
set $term alacritty

# Your preferred application launcher
set $menu wmenu-run-color

seat seat0 xcursor_theme Silksong 24

#font pango:monospace 0.001
titlebar_padding 1
titlebar_border_thickness 0
default_border pixel 4px


# border background text indicator child_border
client.focused #4c7899ff #CC6600 #ffffff #2e9ef4 #CC6600
client.unfocused #333333ff #222222 #888888 #292d2e #222222
client.urgent #2f343a #900000 #ffffff  #900000 #900000
client.background  #ffffff
client.focused_inactive #333333 #5f676a #ffffff #484e50 #5f676a
client.placeholder #000000 #0c0c0c #ffffff #000000 #0c0c0c

gaps inner 4
gaps outer 2

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output * bg ~/.config/sway/background/bg-4 fill
#
# Example configuration:
#
#   output HDMI-A-1 resolution 1920x1080 position 1920,0
#
# You can get the names of your outputs by running: swaymsg -t get_outputs
#output eDP-1 {
#    resolution 1920x1080
#    position 0,0
#    scale 1
#}
#
output DP-1 {
    resolution 2560x1440
    position 0,0
    scale 1
}


### Idle configuration
#
# Example configuration:
#
#exec swayidle -w \
#         timeout 300 'swaylock -f' \
#         timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
#         before-sleep 'swaylock -f'
         #timeout 1200 'systemctl suspend'

# This will lock your screen after 300 seconds of inactivity, then turn off
# your displays after another 300 seconds, and turn your screens back on when
# resumed. It will also lock your screen before your computer goes to sleep.

exec "fcitx5 -d"


# app floating
include $HOME/.config/sway/sway.d/floating.conf
include $HOME/.config/sway/sway.d/keybingings.conf


### Input configuration
#
# Example configuration:
#
input type:touchpad {
    dwt enabled
    tap enabled
    natural_scroll enabled
    middle_emulation enabled
}

input type:keyboard {
     xkb_layout "us"
     xkb_options "altwin:swap_alt_win"
}
#
# You can also configure each device individually.
# Read `man 5 sway-input` for more information about this section.


#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.


exec "\rm ~/.config/waybar/config.jsonc"
exec "ln -s ~/.config/waybar/sway.jsonc ~/.config/waybar/config.jsonc"
bar {
    #position bottom

    # When the status_command prints a new line to stdout, swaybar updates.
    # The default just shows the current date and time.
    #status_command while date +'%Y-%m-%d %X'; do sleep 1; done
    #status_command while ~/.config/sway/status.sh; do sleep 1; done
    swaybar_command waybar
    #colors {
    #    statusline #ffffff
    #    background #323232
    #    inactive_workspace #32323200 #32323200 #5c5c5c
    #}
}

include /etc/sway/config.d/*
